# Aplicação
PORT=3000
NODE_ENV=development

# Frontend (obrigatória em produção)
FRONTEND_URL=

# PostgreSQL (Docker Compose)
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar_secret
POSTGRES_DB=radar_passagens
POSTGRES_PORT=5432

DATABASE_URL="postgresql://radar:radar_secret@localhost:5432/radar_passagens?schema=public"

# Ignav Flight Prices API
IGNAV_API_KEY=
IGNAV_BASE_URL=https://ignav.com/api

# Telegram: alertas e códigos de confirmação
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_API_URL=http://localhost:3000

# Autenticação
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
