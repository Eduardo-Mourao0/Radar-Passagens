generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rota {
  id                 String           @id @default(uuid())
  chaveMonitoramento String           @unique
  origem             String
  destino            String
  dataIda            DateTime
  dataVolta          DateTime?
  ativa              Boolean          @default(true)
  criadoEm           DateTime         @default(now())
  historicos         HistoricoPreco[]

  @@index([ativa])
}

model HistoricoPreco {
  id         String   @id @default(uuid())
  rotaId     String
  rota       Rota     @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  preco      Decimal  @db.Decimal(10, 2)
  moeda      String
  companhia  String
  coletadoEm DateTime @default(now())

  @@index([rotaId, coletadoEm(sort: Desc)])
}
